# API Keys cho các dịch vụ tạo ảnh/video AI (Cloud)
# Chỉ điền key của nền tảng bạn sử dụng

# Ollama Local LLM (Chạy trên máy, $0)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_KEEP_ALIVE=2m
OLLAMA_NUM_CTX=8192
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1

# Google Gemini / Veo API
GEMINI_API_KEY=

# Fal.ai (Hỗ trợ Kling, Wan 2.2/2.5, FLUX Kontext...)
FAL_KEY=

# Giọng đọc Tiếng Việt (Vbee / FPT.AI)
VBEE_API_KEY=
VBEE_APP_ID=
FPT_API_KEY=

# Giọng KOL local — VoiceStudio (AGPL, cài NGOÀI repo) hoặc sidecar VoxCPM2 (Gói 7)
# Chỉ được trỏ tới loopback (127.0.0.1 / localhost / ::1). Engine duy nhất được phép: voxcpm2 (OmniVoice là CC-BY-NC, cấm).
LOCAL_TTS_PROVIDER=voicestudio
LOCAL_TTS_URL=http://127.0.0.1:3900
LOCAL_TTS_API_KEY=
LOCAL_TTS_MODEL=voxcpm2
LOCAL_TTS_TIMEOUT_MS=600000
# Điền "voxcpm2" nếu discovery của VoiceStudio không lộ engine và bạn đã tự kiểm trong app
LOCAL_TTS_ENGINE_CONFIRMED=
# Chế độ managed: pipeline tự mở VoiceStudio headless rồi tắt sau pha TTS (lệnh xác minh ở Task 0)
LOCAL_TTS_START_CMD=
LOCAL_TTS_START_CWD=

# Python cho tools/speech (faster-whisper, Demucs). Bỏ trống để dùng tools/speech/.venv
SPEECH_PYTHON=

# Runway API
RUNWAYML_API_SECRET=

# HeyGen / ElevenLabs (Tùy chọn cho Avatar nói & Lồng tiếng)
HEYGEN_API_KEY=
ELEVENLABS_API_KEY=
