# API Keys cho các dịch vụ tạo ảnh/video AI (Cloud)
# Chỉ điền key của nền tảng bạn sử dụng

# Ollama Local LLM (Chạy trên máy, $0)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_KEEP_ALIVE=2m
OLLAMA_NUM_CTX=8192
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1

# Google Gemini / Veo API
GEMINI_API_KEY=

# Fal.ai (Hỗ trợ Kling, Wan 2.2/2.5, FLUX Kontext...)
FAL_KEY=

# Giọng đọc Tiếng Việt (Vbee / FPT.AI)
VBEE_API_KEY=
VBEE_APP_ID=
FPT_API_KEY=

# Runway API
RUNWAYML_API_SECRET=

# HeyGen / ElevenLabs (Tùy chọn cho Avatar nói & Lồng tiếng)
